    OVERLAP_FRAC = 0.06

    def _assign_offsets(self):
        groups = {}
        for m in self.mons:
            groups.setdefault((m["x"], m["y"]), []).append(m)
        serial = 0
        for grp in groups.values():
            mirror = len(grp) > 1
            if mirror:
                serial += 1
                color = MIRROR_COLORS[(serial - 1) % len(MIRROR_COLORS)]
            else:
                color = None
            dx = max(1, int(grp[0]["w"] * self.OVERLAP_FRAC))
            dy = max(1, int(grp[0]["h"] * self.OVERLAP_FRAC))
            for i, m in enumerate(grp):
                m["_mirror"] = mirror
                m["_mcolor"] = color
                m["_mgid"] = serial
                m["_ox"] = i * dx
                m["_oy"] = i * dy

    def _reassign_nums(self):
        order = sorted(self.boxes, key=lambda b: (
            b.data["x"] + b.data.get("_ox", 0),
            b.data["y"] + b.data.get("_oy", 0)))
        for i, box in enumerate(order, 1):
            box.set_num(i)

    def load_saved(self):
        if self.list_profiles():
            self.load(silent=True)

    def redetect(self):
        fresh = {m["name"]: m for m in get_monitors()}
        for old in self.mons:
            new = fresh.get(old["name"])
            if not new:
                continue
            new["x"], new["y"] = old["x"], old["y"]
            new["primary"] = old["primary"]
            new["enabled"] = old.get("enabled", True)
            if old.get("rotate"):
                new["rotate"] = old["rotate"]
                new["w"], new["h"] = (new["nh"], new["nw"]) if old["rotate"] in (
                    "right", "left") else (new["nw"], new["nh"])
            if old.get("rate"):
                new["rate"] = old["rate"]
        self.mons = [fresh[m["name"]] for m in self.mons if m["name"] in fresh]
        self.mons = self.mons + [m for m in fresh.values()
                                 if m["name"] not in {x["name"] for x in self.mons}]
        self.rescale()
        self.status.config(text=f"redetected: {len(self.mons)} monitors")

    def unmirror(self):
        targets = self.mons
        if self.selected is not None and self.selected.data.get("_mirror"):
            key = (self.selected.data["x"], self.selected.data["y"])
            targets = [m for m in self.mons if (m["x"], m["y"]) == key]
        groups = {}
        for m in targets:
            groups.setdefault((m["x"], m["y"]), []).append(m)
        moved = 0
        for grp in groups.values():
            if len(grp) < 2:
                continue
            y = grp[0]["y"]
            cursor = grp[0]["x"] + grp[0]["w"]
            for m in grp[1:]:
                cursor = self._free_x(cursor, y, m, grp)
                m["x"], m["y"] = cursor, y
                cursor += m["w"]
            moved += len(grp)
        if not moved:
            self.status.config(text="no mirrored monitors")
            return
        self.status.config(text=f"unmirrored {moved} monitors")
        self.rescale()

    def _free_x(self, x, y, mon, grp):
        while True:
            conflict = None
            for o in self.mons:
                if o in grp:
                    continue
                if x < o["x"] + o["w"] and o["x"] < x + mon["w"] \
                        and y < o["y"] + o["h"] and o["y"] < y + mon["h"]:
                    if conflict is None or \
                            o["x"] + o["w"] > conflict["x"] + conflict["w"]:
                        conflict = o
            if conflict is None:
                return x
            x = conflict["x"] + conflict["w"]

    def rescale(self):
        cw = self.canvas.winfo_width()
        ch = self.canvas.winfo_height()
        if cw < 10 or ch < 10:
            return
        self._assign_offsets()
        total_w = max(m["x"] + m["w"] + m.get("_ox", 0) for m in self.mons)
        total_h = max(m["y"] + m["h"] + m.get("_oy", 0) for m in self.mons)
        self.scale = min((cw - 20) / total_w, (ch - 20) / total_h) * self.zoom
        self.canvas.delete("mon")
        self.selected = None
        self.drag = None
        self.boxes = []
        for m in self.mons:
            self.boxes.append(MonitorBox(self.canvas, m, self.scale, app=self))
        self._reassign_nums()

    def find_box(self, event):
        x, y = event.x, event.y
        for box in self.boxes:
            w, h = box.size()
            bx, by = box.pos()
            bx = bx * self.scale + self.pan_x
            by = by * self.scale + self.pan_y
            if bx <= x <= bx + w and by <= y <= by + h:
                return box
        return None

    def on_press(self, event):
        items = self.canvas.find_overlapping(
            event.x - 1, event.y - 1, event.x + 1, event.y + 1)
        for it in items:
            if "mainpill" in self.canvas.gettags(it):
                for box in self.boxes:
                    if box.pill == it or box.pill_txt == it:
                        box.toggle_primary()
                        return
            if "powerpill" in self.canvas.gettags(it):
                for box in self.boxes:
                    if box.pow == it or box.pow_txt == it:
                        box.toggle_power()
                        return
        box = self.find_box(event)
        if box:
            px, py = box.pos()
            self.drag = (box,
                         (event.x - self.pan_x) / self.scale - px,
                         (event.y - self.pan_y) / self.scale - py)
            if self.selected:
                self.selected.data["selected"] = False
                self.selected.draw()
            self.selected = box
            box.data["selected"] = True
            box.draw()
        else:
            self.panning = (event.x, event.y, self.pan_x, self.pan_y)
            self.canvas.config(cursor="fleur")

    def on_drag(self, event):
        if self.panning:
            self.on_pan_drag(event)
            return
        if not self.drag:
            return
        box, offx, offy = self.drag
        if box.data.get("_ox") or box.data.get("_oy"):
            box.data["x"] += box.data["_ox"]
            box.data["y"] += box.data["_oy"]
            box.data["_ox"] = 0
            box.data["_oy"] = 0
        box.data["_mirror"] = False
        box.data["_mcolor"] = None
        box.data["_mgid"] = 0
        nx = (event.x - self.pan_x) / self.scale - offx
        ny = (event.y - self.pan_y) / self.scale - offy
        box.data["x"], box.data["y"] = self.snap(box, int(max(0, nx)), int(max(0, ny)))
        box.draw()

    def snap(self, box, x, y):
        snap_x = [0]
        snap_y = [0]
        for other in self.mons:
            if other is box.data:
                continue
            snap_x += [other["x"], other["x"] + other["w"],
                       other["x"] + other["w"] // 2 - box.data["w"] // 2]
            snap_y += [other["y"], other["y"] + other["h"],
                       other["y"] + other["h"] // 2 - box.data["h"] // 2]
        tol = 40
        for t in snap_x:
            if abs(x - t) < tol:
                x = t
                break
        for t in snap_y:
            if abs(y - t) < tol:
                y = t
                break
        return x, y

    def on_release(self, _):
        self.panning = None
        self.canvas.config(cursor="")
        self.drag = None
        self._assign_offsets()
        for box in self.boxes:
            box.draw()
        self._reassign_nums()

    def on_pan_press(self, event):
        self.panning = (event.x, event.y, self.pan_x, self.pan_y)
        self.canvas.config(cursor="fleur")

    def on_pan_drag(self, event):
        if not self.panning:
            return
        sx, sy, ox, oy = self.panning
        self.pan_x = ox + (event.x - sx)
        self.pan_y = oy + (event.y - sy)
        for box in self.boxes:
            box.draw()

    def on_pan_release(self, _):
        self.panning = None
        self.canvas.config(cursor="")

    def zoom_by(self, factor, ax=None, ay=None):
        old = self.zoom
        new = max(0.1, min(8.0, old * factor))
        if new == old:
            return
        if ax is None:
            ax = self.canvas.winfo_width() / 2
        if ay is None:
            ay = self.canvas.winfo_height() / 2
        self.pan_x = ax - (ax - self.pan_x) * (new / old)
        self.pan_y = ay - (ay - self.pan_y) * (new / old)
        self.zoom = new
        self.rescale()

    def zoom_fit(self):
        self.zoom = 1.0
        self.pan_x = 0.0
        self.pan_y = 0.0
        self.rescale()

    def pos_num(self, m):
        order = sorted(self.boxes, key=lambda b: (
            b.data["x"] + b.data.get("_ox", 0),
            b.data["y"] + b.data.get("_oy", 0)))
        for i, box in enumerate(order, 1):
            if box.data is m:
                return i
        return 0

    def on_identify(self, event):
        box = self.find_box(event)
        if box:
            m = box.data
            flash(m, m["name"], f"#{self.pos_num(m)}")

    def identify_all(self):
        for box in self.boxes:
            m = box.data
            flash(m, str(self.pos_num(m)), m["name"])

    PROFILE_DIR = os.path.expanduser("~/.config/i3mon")

    def profile_path(self, name=None):
        name = (name or self.profile_var.get()).strip()
        return os.path.join(self.PROFILE_DIR, f"{name}.json")

    def list_profiles(self):
        try:
            return sorted(
                f[:-5] for f in os.listdir(self.PROFILE_DIR) if f.endswith(".json")
            )
        except FileNotFoundError:
            return []

    def apply(self):
        for m in self.mons:
            m["x"], m["y"] = int(m["x"]), int(m["y"])
        cmd = ["xrandr"]
        for m in self.mons:
            if not m.get("enabled", True):
                cmd += ["--output", m["name"], "--off"]
                continue
            cmd += ["--output", m["name"], "--mode", f"{m['nw']}x{m['nh']}",
                    "--pos", f"{m['x']}x{m['y']}"]
            if m.get("rate"):
                cmd += ["--rate", f"{m['rate']:g}"]
            if m.get("rotate"):
                cmd += ["--rotate", m["rotate"]]
        for m in self.mons:
            if m["primary"]:
                cmd += ["--output", m["name"], "--primary"]
        try:
            subprocess.check_call(cmd)
            self.status.config(text="applied ✓")
        except subprocess.CalledProcessError as e:
            self.status.config(text=f"error: {e}")

    def save(self):
        name = self.profile_var.get().strip()
        if not name:
            self.status.config(text="enter a profile name first")
            return
        data = []
        for m in self.mons:
            data.append({
                "name": m["name"],
                "x": int(m["x"]), "y": int(m["y"]),
                "rotate": m.get("rotate", "normal"),
                "rate": m.get("rate"),
                "enabled": m.get("enabled", True),
                "primary": m["primary"],
            })
        path = self.profile_path(name)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            json.dump(data, f, indent=2)
        self.profile_entry["values"] = self.list_profiles()
        self.status.config(text=f"saved → {path}")

    def load(self, silent=False):
        name = (self.profile_var.get() if not silent else None) or None
        if not silent and not name.strip():
            self.status.config(text="pick a profile to load")
            return
        candidates = [self.profile_path(name)] if name else [
            os.path.join(self.PROFILE_DIR, f) for f in self.list_profiles()
        ]
        path = next((p for p in candidates if os.path.exists(p)), None)
        if path is None:
            if not silent:
                self.status.config(text=f"profile not found: {name}")
            return
        try:
            with open(path) as f:
                data = json.load(f)
        except (json.JSONDecodeError,) as e:
            self.status.config(text=f"load failed: {e}")
            return
        if not silent:
            self.profile_var.set(os.path.splitext(os.path.basename(path))[0])
        by_name = {m["name"]: m for m in self.mons}
        for d in data:
            m = by_name.get(d["name"])
            if not m:
                continue
            m["x"], m["y"] = d["x"], d["y"]
            rot = d.get("rotate", "normal")
            if rot == "normal":
                m.pop("rotate", None)
            else:
                m["rotate"] = rot
            m["w"], m["h"] = (m["nh"], m["nw"]) if rot in ("right", "left") \
                else (m["nw"], m["nh"])
            m["primary"] = d.get("primary", False)
            m["rate"] = d.get("rate")
            m["enabled"] = d.get("enabled", m.get("enabled", True))
        self.rescale()
        if not silent:
            self.status.config(text=f"loaded → {path}")


def main():
    import argparse

    parser = argparse.ArgumentParser(
        prog="i3mon",
        description="Arrange, rotate, save and apply monitor layouts (i3).",
    )
    parser.add_argument("profile", nargs="?", default=None,
                        help="profile name to load on start (default: last used)")
    parser.add_argument("--apply", action="store_true",
                        help="apply the profile to the live display and exit")
    parser.add_argument("--list", action="store_true",
                        help="list available profiles and exit")
    args = parser.parse_args()

    mons = get_monitors()
    if not mons:
        print("no connected monitors found", file=sys.stderr)
        return 1

    profiles = [
        f[:-5] for f in os.listdir(App.PROFILE_DIR) if f.endswith(".json")
    ] if os.path.isdir(App.PROFILE_DIR) else []
    profiles.sort()

    if args.list:
        print("\n".join(profiles) if profiles else "(no profiles saved)")
        return 0

    if args.profile and args.profile not in profiles:
        print(f"profile not found: {args.profile}", file=sys.stderr)
        return 1

    if args.apply:
        if not args.profile:
            print("--apply requires a profile name", file=sys.stderr)
            return 1
        path = os.path.join(App.PROFILE_DIR, f"{args.profile}.json")
        apply_profile(mons, path)
        print(f"applied: {args.profile}")
        return 0

    root = tk.Tk()
    setup_styles()
    app = App(root, mons)
    if args.profile:
        app.profile_var.set(args.profile)
        app.load()
    root.mainloop()
    return 0


def apply_profile(mons, path):
    with open(path) as f:
        data = json.load(f)
    by_name = {m["name"]: m for m in mons}
    cmd = ["xrandr"]
    for d in data:
        m = by_name.get(d["name"])
        if not m:
            continue
        if not d.get("enabled", True):
            cmd += ["--output", m["name"], "--off"]
            continue
        cmd += ["--output", m["name"], "--mode", f"{m['nw']}x{m['nh']}",
                "--pos", f"{d['x']}x{d['y']}"]
        if d.get("rate"):
            cmd += ["--rate", f"{d['rate']:g}"]
        rot = d.get("rotate", "normal")
        if rot != "normal":
            cmd += ["--rotate", rot]
        if d.get("primary"):
            cmd += ["--primary"]
    subprocess.check_call(cmd)


if __name__ == "__main__":
    raise SystemExit(main())