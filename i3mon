def get_monitors():
    out = subprocess.check_output(["xrandr", "--query"]).decode()
    monitors = []
    current = None
    for line in out.splitlines():
        m = re.match(
            r"^(\S+) connected (primary )?(\d+)x(\d+)\+(\d+)\+(\d+)"
            r"( (normal|left|right|inverted))?", line
        )
        m_plain = re.match(r"^(\S+) connected (primary )?\((.+)\)\s*$", line)
        if m or m_plain:
            if current is not None:
                monitors.append(current)
            if m:
                name, primary, w, h, x, y, _, rotate = m.groups()
                rotate = rotate if rotate else "normal"
                nw, nh = int(w), int(h)
                if rotate in ("left", "right"):
                    nw, nh = nh, nw
                current = {
                    "name": name,
                    "primary": bool(primary),
                    "w": int(w), "h": int(h), "x": int(x), "y": int(y),
                    "nw": nw, "nh": nh,
                    "rotate": rotate,
                    "rate": None,
                    "rates": [],
                    "geo": True,
                    "active": True,
                    "enabled": True,
                }
            else:
                name, primary, _ = m_plain.groups()
                current = {
                    "name": name,
                    "primary": bool(primary),
                    "w": 0, "h": 0, "x": 0, "y": 0,
                    "nw": 0, "nh": 0,
                    "rotate": "normal",
                    "rate": None,
                    "rates": [],
                    "geo": False,
                    "active": False,
                    "enabled": False,
                }
        elif current is not None and line.startswith(" "):
            mode = re.match(r"\s+(\d+)x(\d+)\s+(.+)$", line)
            if not mode:
                continue
            if not re.fullmatch(r"[\d.*+]+(\s+[\d.*+]+)*\s*", mode.group(3)):
                continue
            mw, mh = int(mode.group(1)), int(mode.group(2))
            tokens = mode.group(3).split()
            rates = []
            for token in tokens:
                num = re.sub(r"[*+]", "", token)
                try:
                    rates.append(float(num))
                except ValueError:
                    continue
            if not current["geo"]:
                if "+" in mode.group(3):
                    current["nw"], current["nh"] = mw, mh
                    current["w"], current["h"] = mw, mh
                    current["rates"] = sorted(set(rates), reverse=True)
                    for token in tokens:
                        if "*" in token:
                            current["rate"] = float(re.sub(r"[*+]", "", token))
                    current["geo"] = True
            elif (mw, mh) == (current["nw"], current["nh"]):
                current["rates"] = sorted(set(rates), reverse=True)
                for token in tokens:
                    if "*" in token:
                        current["rate"] = float(re.sub(r"[*+]", "", token))
    if current is not None:
        monitors.append(current)

    right = max((m["x"] + m["w"] for m in monitors), default=0)
    for m in monitors:
        if not m["active"]:
            m["x"], m["y"] = right, 0
            right += m["w"]
            m["geo"] = True
            m["active"] = True
    return monitors


def flash(mon, text, sub=None):
    import tkinter as tk
    from tkinter import font as tkfont
    top = tk.Toplevel()
    top.overrideredirect(True)
    top.attributes("-topmost", True)
    top.configure(bg="black")
    fsize = 280 if len(text) <= 1 else 90
    if sub:
        frame = tk.Frame(top, bg="black")
        frame.pack(expand=True)
        tk.Label(frame, text=text, bg="black", fg=COL_ACCENT,
                 font=tkfont.Font(size=fsize, weight="bold")).pack()
        tk.Label(frame, text=sub, bg="black", fg=COL_TEXT,
                 font=tkfont.Font(size=40, weight="bold")).pack(pady=16)
    else:
        lab = tk.Label(top, text=text, bg="black", fg=COL_ACCENT,
                       font=tkfont.Font(size=fsize, weight="bold"))
        lab.pack(expand=True, fill="both")
    w = max(520, len(text) * fsize // 2 + 80)
    h = m11ax(520, fsize + 120)
    x = mon["x"] + mon.get("_ox", 0) + mon["w"] // 2 - w // 2
    y = mon["y"] + mon.get("_oy", 0) + mon["h"] // 2 - h // 2
    top.geometry(f"{w}x{h}+{x}+{y}")
    top.after(2000, top.destroy)


ROTATION_LABELS = {
    "normal": "Landscape",
    "right": "Portrait",
    "inverted": "Landscape (flipped)",
    "left": "Portrait (flipped)",
}
ROTATION_VALUES = {
    "Landscape": "normal",
    "Portrait": "right",
    "Landscape (flipped)": "inverted",
    "Portrait (flipped)": "left",
}


class MonitorBox:
    def __init__(self, canvas, data, scale, app=None, num=None):
        self.canvas = canvas
        self.data = data
        self.scale = scale
        self.app = app
        self.num = num
        self.item = None
        self.label = None
        self.sub = None
        self.badge = None
        self.num_label = None
        self.combo = None
        self.rate_combo = None
        self.pill = None
        self.pill_txt = None
        self.pow = None
        self.pow_txt = None
        self.mirror_lbl = None
        self.draw()

    def pos(self):
        return (self.data["x"] + self.data.get("_ox", 0),
                self.data["y"] + self.data.get("_oy", 0))

    def size(self):
        return int(self.data["w"] * self.scale), int(self.data["h"] * self.scale)

    def on_orient(self, _=None):
        cur = self.data.get("rotate", "normal")
        nxt = ROTATION_VALUES[self.combo.get()]
        if nxt == "normal":
            self.data.pop("rotate", None)
        else:
            self.data["rotate"] = nxt
        native_w, native_h = self.data["nw"], self.data["nh"]
        if nxt in ("right", "left"):
            self.data["w"], self.data["h"] = native_h, native_w
        else:
            self.data["w"], self.data["h"] = native_w, native_h
        self.draw()

    def on_rate(self, _=None):
        sel = self.rate_combo.get()
        if sel and sel != "auto":
            self.data["rate"] = float(sel.split()[0])
        else:
            self.data["rate"] = None

    def rate_label(self, r):
        return "auto" if r is None else f"{r:g} Hz"

    def sub_text(self):
        return f"{self.data['w']}×{self.data['h']}"

    def outline_color(self, enabled):
        if self.data.get("_mirror"):
            return self.data.get("_mcolor") or COL_WARN
        return COL_ACCENT_DIM if enabled else "#2a3040"

    def mirror_text(self):
        return f"⧉ mirror {self.data.get('_mgid', 1)}"

    def draw(self):
        w, h = self.size()
        px = self.app.pan_x if self.app else 0
        py = self.app.pan_y if self.app else 0
        x = (self.data["x"] + self.data.get("_ox", 0)) * self.scale + px
        y = (self.data["y"] + self.data.get("_oy", 0)) * self.scale + py
        enabled = self.data.get("enabled", True)
        fill = COL_CARD
        if self.data.get("selected"):
            fill = COL_CARD_ALT
        if not enabled:
            fill = "#181c24"
        if self.item is None:
            self.item = self.canvas.create_rectangle(
                x + 2, y + 2, x + w - 2, y + h - 2,
                outline=self.outline_color(enabled), width=2,
                fill=fill, tags="mon",
            )
            self.badge = self.canvas.create_oval(
                x + 8, y + 8, x + 8 + 12, y + 8 + 12,
                fill=self.dot_color(), outline="", tags="mon",
            )
            self.num_label = self.canvas.create_text(
                x + 30, y + 26, text=str(self.num) if self.num else "",
                fill=COL_TEXT, anchor="nw",
                font=tkfont.Font(size=max(10, min(w, h) // 10), weight="bold"),
                tags="mon",
            )
            if self.data.get("_mirror"):
                self.mirror_lbl = self.canvas.create_text(
                    x + 10, y + 48, text=self.mirror_text(),
                    fill=self.data.get("_mcolor") or COL_WARN, anchor="nw",
                    font=tkfont.Font(size=max(8, min(w, h) // 18), weight="bold"),
                    tags="mon",
                )
            self.label = self.canvas.create_text(
                x + w / 2, y + h / 2 - 12,
                text=self.data["name"], fill=COL_TEXT,
                font=tkfont.Font(size=max(8, min(w, h) // 6), weight="bold"),
                tags="mon",
            )
            self.sub = self.canvas.create_text(
                x + w / 2, y + h / 2 + max(10, min(w, h) // 12),
                text=self.sub_text(),
                fill=COL_MUTED,
                font=tkfont.Font(size=max(7, min(w, h) // 14)),
                tags="mon",
            )
            self.combo = ttk.Combobox(
                self.canvas, values=("Landscape", "Portrait",
                                     "Landscape (flipped)", "Portrait (flipped)"),
                state="readonly", width=16,
            )
            self.combo.set(ROTATION_LABELS[self.data.get("rotate", "normal")])
            self.combo.bind("<<ComboboxSelected>>", self.on_orient)
            self.combo_win = self.canvas.create_window(
                x + w / 2, y + h - 32, window=self.combo, tags="mon",
            )
            rate_vals = ["auto"] + [f"{r:g} Hz" for r in self.data["rates"]]
            self.rate_combo = ttk.Combobox(
                self.canvas, values=rate_vals, state="readonly", width=10,
            )
            self.rate_combo.set(self.rate_label(self.data["rate"]))
            self.rate_combo.bind("<<ComboboxSelected>>", self.on_rate)
            self.rate_win = self.canvas.create_window(
                x + w / 2, y + h - 60, window=self.rate_combo, tags="mon",
            )
            pw = 58
            ph = 22
            px, py = x + w / 2 + 4, y + 12
            pill_on = self.data.get("primary", False)
            self.pill = self.canvas.create_rectangle(
                px, py, px + pw, py + ph,
                fill=COL_OK if pill_on else COL_CARD,
                outline="#3a4150", width=1, tags="mon mainpill",
            )
            self.pill_txt = self.canvas.create_text(
                px + pw / 2, py + ph / 2, text="main",
                fill="#0d1017" if pill_on else COL_MUTED,
                font=tkfont.Font(size=9, weight="bold"),
                tags="mon mainpill",
            )
            ppx = x + w / 2 - 4 - pw
            on = self.data.get("enabled", True)
            self.pow = self.canvas.create_rectangle(
                ppx, py, ppx + pw, py + ph,
                fill="#2f7a55" if on else COL_WARN,
                outline="#3a4150", width=1, tags="mon powerpill",
            )
            self.pow_txt = self.canvas.create_text(
                ppx + pw / 2, py + ph / 2, text="on" if on else "off",
                fill="#0d1017" if on else COL_BG,
                font=tkfont.Font(size=9, weight="bold"),
                tags="mon powerpill",
            )
        else:
            self.canvas.itemconfig(self.item, fill=fill)
            self.canvas.itemconfig(self.item, outline=self.outline_color(enabled))
            self.canvas.coords(self.item, x + 2, y + 2, x + w - 2, y + h - 2)
            self.canvas.coords(self.badge, x + 8, y + 8, x + 20, y + 20)
            self.canvas.itemconfig(self.badge, fill=self.dot_color())
            self.canvas.coords(self.num_label, x + 30, y + 26)
            self.canvas.itemconfig(self.num_label, text=str(self.num) if self.num else "")
            if self.data.get("_mirror"):
                text = self.mirror_text()
                color = self.data.get("_mcolor") or COL_WARN
                if self.mirror_lbl is None:
                    self.mirror_lbl = self.canvas.create_text(
                        x + 10, y + 48, text=text, fill=color, anchor="nw",
                        font=tkfont.Font(size=max(8, min(w, h) // 18),
                                         weight="bold"),
                        tags="mon",
                    )
                else:
                    self.canvas.coords(self.mirror_lbl, x + 10, y + 48)
                    self.canvas.itemconfig(self.mirror_lbl, text=text, fill=color)
            elif self.mirror_lbl is not None:
                self.canvas.delete(self.mirror_lbl)
                self.mirror_lbl = None
            self.canvas.coords(self.label, x + w / 2, y + h / 2 - 12)
            self.canvas.coords(self.sub, x + w / 2, y + h / 2 + max(10, min(w, h) // 12))
            self.canvas.coords(self.combo_win, x + w / 2, y + h - 32)
            self.canvas.coords(self.rate_win, x + w / 2, y + h - 60)
            self.rate_combo.set(self.rate_label(self.data["rate"]))
            pw = 58
            ph = 22
            px, py = x + w / 2 + 4, y + 12
            pill_on = self.data.get("primary", False)
            self.canvas.coords(self.pill, px, py, px + pw, py + ph)
            self.canvas.itemconfig(
                self.pill, fill=COL_OK if pill_on else COL_CARD)
            self.canvas.coords(self.pill_txt, px + pw / 2, py + ph / 2)
            self.canvas.itemconfig(
                self.pill_txt, text="main",
                fill="#0d1017" if pill_on else COL_MUTED)
            ppx = x + w / 2 - 4 - pw
            on = self.data.get("enabled", True)
            self.canvas.coords(self.pow, ppx, py, ppx + pw, py + ph)
            self.canvas.itemconfig(
                self.pow, fill="#2f7a55" if on else COL_WARN)
            self.canvas.coords(self.pow_txt, ppx + pw / 2, py + ph / 2)
            self.canvas.itemconfig(
                self.pow_txt, text="on" if on else "off",
                fill="#0d1017" if on else COL_BG)
            self.canvas.itemconfig(self.sub, text=self.sub_text())
            self.combo.set(ROTATION_LABELS[self.data.get("rotate", "normal")])

    def dot_color(self):
        if self.data.get("primary"):
            return COL_OK
        if self.data.get("rotate"):
            return COL_WARN
        return COL_ACCENT_DIM

    def set_num(self, num):
        self.num = num
        if self.num_label is not None:
            self.canvas.itemconfig(self.num_label, text=str(num))

    def toggle_primary(self):
        if self.app is None:
            return
        if not self.data.get("primary"):
            for box in self.app.boxes:
                box.data["primary"] = box is self
        else:
            self.data["primary"] = False
        self.app.rescale()

    def toggle_power(self):
        if self.app is None:
            return
        self.data["enabled"] = not self.data.get("enabled", True)
        self.draw()


